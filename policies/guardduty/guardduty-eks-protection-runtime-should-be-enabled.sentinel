# This control checks whether 'aws_guardduty_detector_feature' EKS Runtime Monitoring with automated agent management is enabled.
# Refer to https://docs.aws.amazon.com/securityhub/latest/userguide/guardduty-controls.html#guardduty-7 for more details.

# Copyright IBM Corp. 2024, 2026
# SPDX-License-Identifier: BUSL-1.1

import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Constants
const = {
	"policy_name":                             "guardduty-eks-protection-runtime-should-be-enabled",
	"resource_aws_guardduty_detector":         "aws_guardduty_detector",
	"resource_aws_guardduty_detector_feature": "aws_guardduty_detector_feature",
	"message": "'aws_guardduty_detector_feature' EKS Runtime Monitoring with automated agent management should be enabled",
}

# Functions

get_violations = func(detectors, features) {
	return collection.reject(detectors, func(detector) {
		if maps.get(detector, "values.enable", true) is not true {
			return false
		}
		detector_id = maps.get(detector, "values.id", "")
		matching_features = filter features as _, feature {
			maps.get(feature, "values.detector_id", "") is detector_id and
				maps.get(feature, "values.name", "") is "EKS_RUNTIME_MONITORING" and
				maps.get(feature, "values.status", "") is "ENABLED"
		}
		return matching_features is not empty
	})
}

# Variables

aws_guardduty_detector = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_guardduty_detector).resources
aws_guardduty_detector_feature = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_guardduty_detector_feature).resources
violations = get_violations(aws_guardduty_detector, aws_guardduty_detector_feature)

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        const.message,
		}
	},
}

# Outputs

print(report.generate_policy_report(summary))

# Rules

main = rule {
	violations is empty
}
