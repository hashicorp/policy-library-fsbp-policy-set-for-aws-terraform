# This policy ensures that GuardDuty ECS Runtime Monitoring is enabled.
# Refer to https://docs.aws.amazon.com/securityhub/latest/userguide/guardduty-controls.html#guardduty-12 for more details.

# Copyright IBM Corp. 2024, 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports

import "tfplan/v2" as tfplan
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Constants

const = {
	"policy_name":                             "guardduty-ecs-protection-runtime-enabled",
	"message":                                 "GuardDuty ECS Runtime Monitoring should be enabled. Ensure that GuardDuty detector is enabled and Runtime Monitoring feature is enabled",
	"resource_aws_guardduty_detector":         "aws_guardduty_detector",
	"resource_aws_guardduty_detector_feature": "aws_guardduty_detector_feature",
}

# Variables

detector_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_guardduty_detector).resources
feature_resources = tf.plan(tfplan.planned_values.resources).type(const.resource_aws_guardduty_detector_feature).resources

violations = collection.reject(detector_resources, func(detector) {
	if maps.get(detector, "values.enable", true) is not true {
		return false
	}
	detector_id = maps.get(detector, "values.id", "")
	matching_features = filter feature_resources as _, feature {
		maps.get(feature, "values.detector_id", "") is detector_id and
			maps.get(feature, "values.name", "") is "RUNTIME_MONITORING" and
			maps.get(feature, "values.status", "") is "ENABLED" and
			not filter maps.get(feature, "values.additional_configuration", []) as _, config {
				maps.get(config, "name", "") is "ECS_FARGATE_AGENT_MANAGEMENT" and
					maps.get(config, "status", "") is "ENABLED"
			} is empty
	}
	return matching_features is not empty
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        const.message,
		}
	},
}

# Outputs

print(report.generate_policy_report(summary))

# Rules

main = rule {
	violations is empty
}
