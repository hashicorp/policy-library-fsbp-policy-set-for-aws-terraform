# This control checks if DNS query logging is enabled for an Amazon Route 53 public hosted zone.
# Refer to https://docs.aws.amazon.com/securityhub/latest/userguide/route53-controls.html#route53-2 for more details.

# Copyright IBM Corp. 2024, 2026
# SPDX-License-Identifier: BUSL-1.1

# Imports

import "tfconfig/v2" as tfconfig
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Constants

const = {
	"policy_name":                    "route-53-public-hosted-zones-should-log-dns-queries",
	"message":                        "Route 53 public hosted zones should log DNS queries",
	"resource_aws_route53_query_log": "aws_route53_query_log",
	"resource_aws_route53_zone":      "aws_route53_zone",
}

# Variables

route53_query_log_resources = tf.config(tfconfig.resources).type(const.resource_aws_route53_query_log).resources
route53_zone_resources = tf.config(tfconfig.resources).type(const.resource_aws_route53_zone).resources

public_zones = filter route53_zone_resources as _, zone {
	maps.get(zone, "config.vpc", []) is empty
}

violations = collection.reject(public_zones, func(zone) {
	for route53_query_log_resources as _, query_log {
		references = maps.get(query_log, "config.zone_id.references", [])
		cloudwatch_log_group_arn = maps.get(query_log, "config.cloudwatch_log_group_arn", {})
		constant_value = maps.get(cloudwatch_log_group_arn, "constant_value", "")
		arn_references = maps.get(cloudwatch_log_group_arn, "references", [])
		has_log_group = arn_references is not empty or (constant_value is not null and constant_value != "")
		if has_log_group and (zone.address in references or zone.address + ".zone_id" in references) {
			return true
		}
	}
	return false
})

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        const.message,
		}
	},
}

# Outputs

print(report.generate_policy_report(summary))

# Rules

main = rule {
	violations is empty
}
