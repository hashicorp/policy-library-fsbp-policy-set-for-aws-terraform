# Fails the test if the policy reports the wrong name or message.
generate_policy_report = func(summary) {
	if summary.policy_name is not "elb-ensure-valid-desync-mitigation-mode" {
		error("unexpected policy_name: " + summary.policy_name)
	}
	if length(summary.violations) is 0 {
		error("expected at least one violation")
	}
	for summary.violations as v {
		if v.message is not "Application load balancers should be configured with defensive or strictest desync mitigation mode" {
			error("unexpected message: " + v.message)
		}
	}
	return ""
}
