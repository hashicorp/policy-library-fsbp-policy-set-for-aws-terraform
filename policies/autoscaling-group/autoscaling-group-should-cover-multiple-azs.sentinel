# This policy checks if resources of type 'aws_autoscaling_group' have more than one value
# in either 'availability_zone' or 'vpc_zone_identifier'
# Refer to https://docs.aws.amazon.com/securityhub/latest/userguide/autoscaling-controls.html#autoscaling-2 for more details.

# Copyright IBM Corp. 2024, 2025
# SPDX-License-Identifier: BUSL-1.1

import "tfconfig/v2" as tfconfig
import "tfresources" as tf
import "report" as report
import "collection" as collection
import "collection/maps" as maps

# Constants
const = {
	"policy_name":                    "autoscaling-group-should-cover-multiple-azs",
	"message":                        "Attribute 'availability_zone' or 'vpc_zone_identifier' should have atleast two values for AWS Autoscaling Group",
	"resource_aws_autoscaling_group": "aws_autoscaling_group",
	"resource_aws_subnet":            "aws_subnet",
}

# Functions

get_violations = func(resources, subnet_resources) {
	return collection.reject(resources, func(res) {
		availability_zones_values = maps.get(res, "config.availability_zones", {})
		vpc_zone_identifier_values = maps.get(res, "config.vpc_zone_identifier", {})
		if length(maps.get(availability_zones_values, "constant_value", [])) > 1 {
			return true
		}

		subnet_references = maps.get(vpc_zone_identifier_values, "references", [])
		referenced_availability_zones = []
		for subnet_resources as _, subnet {
			if subnet.address not in subnet_references {
				continue
			}
			availability_zone = maps.get(subnet, "config.availability_zone.constant_value", "")
			if availability_zone is not empty and availability_zone not in referenced_availability_zones {
				append(referenced_availability_zones, availability_zone)
			}
		}

		if referenced_availability_zones is not empty {
			return length(referenced_availability_zones) > 1
		}

		// Preserve the existing result when referenced subnet AZs are unavailable.
		return length(subnet_references) > 2
	})
}

# Variables

config_resources = tf.config(tfconfig.resources)
autoscaling_groups_config_resources = config_resources.type(const.resource_aws_autoscaling_group).resources
subnet_config_resources = config_resources.type(const.resource_aws_subnet).resources
violations = get_violations(autoscaling_groups_config_resources, subnet_config_resources)

summary = {
	"policy_name": const.policy_name,
	"violations": map violations as _, v {
		{
			"address":        v.address,
			"module_address": v.module_address,
			"message":        const.message,
		}
	},
}

# Outputs
print(report.generate_policy_report(summary))

# Rules

main = rule {
	violations is empty
}
