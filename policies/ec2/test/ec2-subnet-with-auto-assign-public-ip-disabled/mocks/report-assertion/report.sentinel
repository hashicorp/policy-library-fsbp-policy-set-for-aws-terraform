# Fails the test if the policy reports the wrong name or message.
generate_policy_report = func(summary) {
	if summary.policy_name is not "ec2-subnet-with-auto-assign-public-ip-disabled" {
		error("unexpected policy_name: " + summary.policy_name)
	}
	return ""
}
